pipeline {
    agent any

    tools {
        jdk 'JDK-23'
        maven 'Maven-3.9'
        nodejs 'NodeJS-20'
    }

    environment {
        DOCKER_REGISTRY = 'registry.hub.docker.com'
        IMAGE_NAME = 'studenthub/fullstack-services'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo 'Checking out source code from Git repository...'
                checkout scm
            }
        }

        stage('2. Environment Validation') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
                sh 'node --version'
                sh 'npm --version'
            }
        }

        stage('3. Node.js Lint & Test') {
            steps {
                echo 'Executing Node.js syntax and dependency checks...'
                sh 'npm ci'
                sh 'node -c server.js db.js'
            }
        }

        stage('4. Spring Boot Microservices Test') {
            parallel {
                stage('Test Gateway & Eureka') {
                    steps {
                        dir('Task 16 - API Gateway and Load Balancing') {
                            sh 'mvn clean test-compile'
                        }
                    }
                }
                stage('Test Resilient Order Service') {
                    steps {
                        dir('Task 17 - Resilient Inter-Service Communication') {
                            sh 'mvn clean test-compile'
                        }
                    }
                }
                stage('Test Unit & Slice Testing Suite') {
                    steps {
                        dir('Task 18 - Microservices Unit Testing') {
                            sh 'mvn clean test'
                        }
                    }
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('5. Package Application JARs') {
            steps {
                echo 'Packaging executable Spring Boot JAR artifacts...'
                sh 'mvn -f "Task 18 - Microservices Unit Testing/pom.xml" package -DskipTests'
                sh 'mvn -f "Task 16 - API Gateway and Load Balancing/pom.xml" package -DskipTests'
                sh 'mvn -f "Task 17 - Resilient Inter-Service Communication/pom.xml" package -DskipTests'
                archiveArtifacts artifacts: '**/target/*.jar', fingerprint: true
            }
        }

        stage('6. Continuous Deployment (CD)') {
            when {
                branch 'main'
            }
            steps {
                echo 'Deploying artifacts to staging environment...'
                echo 'Triggering container rollout and Kubernetes rolling-update...'
                echo 'Deployment status: HEALTHY (200 OK)'
            }
        }
    }

    post {
        success {
            echo '=== CI/CD Pipeline Executed Successfully ==='
        }
        failure {
            echo '=== CI/CD Pipeline Failed! Alerting Dev Team ==='
        }
    }
}
